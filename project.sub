universe = vanilla
executable = /bin/bash

# One archive of spectra is processed per job. Create archives.txt with one
# archive path per line before submitting.
arguments = project.sh cB58_Lyman_break.fit $(archive) result_$(Process).csv

log    = logs/cb58_$(Cluster)_$(Process).log
error  = logs/cb58_$(Cluster)_$(Process).err
output = logs/cb58_$(Cluster)_$(Process).out

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = project.R,project.sh,cB58_Lyman_break.fit,$(archive)
transfer_output_files = result_$(Process).csv

request_cpus = 1
request_memory = 2GB
request_disk = 2GB

queue archive from archives.txt
